# Include important files in the package
include README.md
include LICENSE
include requirements.txt
include sync.py

# Include all Python files
recursive-include buildtools *.py

# Exclude development and cache files
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude __pycache__
global-exclude .git*
global-exclude .DS_Store
global-exclude *.egg-info
